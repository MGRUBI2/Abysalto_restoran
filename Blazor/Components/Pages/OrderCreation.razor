@page "/createOrder"
@using System.Data.Common
@using AbySalto.Junior.Application.Dto
@rendermode InteractiveServer
@inject HttpClient Http

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h3 class="text-primary text-center mb-4">Add Order</h3>

                    <EditForm Model="order" OnValidSubmit="HandleSubmit">

                        <div class="mb-3">
                            <label class="form-label">Guest Name</label>
                            <InputText class="form-control" @bind-Value="order.GuestName" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Payment Method</label>
                            <InputSelect class="form-select" @bind-Value="order.Payment">
                                <option value="0">Cash</option>
                                <option value="1">Debit</option>
                                <option value="2">Credit</option>
                                <option value="3">Mobile</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Address</label>
                            <InputText class="form-control" @bind-Value="order.Address" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Phone Number</label>
                            <InputText class="form-control" @bind-Value="order.PhoneNumber" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Notes</label>
                            <InputTextArea class="form-control" @bind-Value="order.Notes" />
                        </div>

                        <hr />

                        <h5 class="text-primary mb-3">Add Articles</h5>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <select class="form-select" @bind="selectedArticleId">
                                    <option value="">Select article</option>

                                    @foreach (var article in articles)
                                    {
                                        <option value="@article.Id">@article.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3 d-grid">
                                <button type="button" class="btn btn-outline-primary" @onclick="AddArticle">
                                    Add
                                </button>
                            </div>
                        </div>

                        <ul class="list-group mb-3">
                            @foreach (var articleId in order.Articles)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@ArticleName(articleId) </span>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            @onclick="() => RemoveItem(articleId)">
                                        x
                                    </button>
                                </li>
                            }
                        </ul>

                        <button type="submit" class="btn btn-primary w-100">
                            Save Order
                        </button>

                    </EditForm>
                    
                    @if (!string.IsNullOrWhiteSpace(message))
                    {
                        <div class="alert alert-info">
                            @message
                        </div>
                    }

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private OrderCreationDto order = new();

    private List<ArticleResponseDto> articles = new();
    private Guid selectedArticleId;
    private string message = "";

    protected override async Task OnInitializedAsync()//M.G: loads with page!
    {
        try
        {
            articles = await Http.GetFromJsonAsync<List<ArticleResponseDto>>("http://localhost:5074/api/v1/article");
        }
        catch (Exception e)
        {
            message ="greska s slanjem: "+ e.Message;
        }
    }
    
    

    private void AddArticle()
    {
        if (selectedArticleId == Guid.Empty)
        {
            message = "there is nothing selected";
            return;
        }
        
        var article = articles.FirstOrDefault(a => a.Id == selectedArticleId);
        if (article == null) return;

        order.Articles.Add(article.Id);

        selectedArticleId = Guid.Empty;
    }

    private void RemoveItem(Guid articleId)
    {
        order.Articles.Remove(articleId);
    }

    private async Task HandleSubmit()
    {
        var response = await Http.PostAsJsonAsync("http://localhost:5074/api/v1/order", order);

        if (response.IsSuccessStatusCode)
        {
            order = new();
        }
    }

    private string ArticleName(Guid id)//M.G: will optimize later
    {
        return articles.Where(a => a.Id == id)
            .Select(a => a.Name).FirstOrDefault();
    }

    public class OrderCreationDto
    {
        public string GuestName { get; set; }
        public int Payment { get; set; }
        public string Address { get; set; }
        public string PhoneNumber { get; set; }
        public string Notes { get; set; }
        public List<Guid> Articles{ get; set; } = new();
    }

}