@page "/createOrder"
@using AbySalto.Junior.Application.Dto
@using AbySalto.Junior.Domain.Enums
@rendermode InteractiveServer
@inject HttpClient Http

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card shadow-sm border-0">
                <div class="card-body p-4">

                    <h3 class="text-primary text-center mb-4">Dodaj Narudžbu</h3>

                    <EditForm Model="order" OnSubmit="HandleSubmit">

                        <div class="mb-3">
                            <label class="form-label">Ime kupca</label>
                            <InputText class="form-control" @bind-Value="order.GuestName"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Način plačanja</label>
                            <InputSelect class="form-select" @bind-Value="order.Payment">
                                <option value="0">Gotovina</option>
                                <option value="1">Debitna kartica</option>
                                <option value="2">Kartica</option>
                                <option value="3">Mobilno plačanje</option>
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Adresa</label>
                            <InputText class="form-control" @bind-Value="order.Address"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Broj mobitela</label>
                            <InputText class="form-control" @bind-Value="order.PhoneNumber"/>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Napomena</label>
                            <InputTextArea class="form-control" @bind-Value="order.Notes"/>
                        </div>

                        <hr/>

                        <h5 class="text-primary mb-3">Dodaj artikal</h5>

                        <div class="row g-2 mb-3">
                            <div class="col-md-6">
                                <select class="form-select" @bind="selectedArticleId">
                                    <option value="">Odaberi artikal</option>

                                    @foreach (var article in articles)
                                    {
                                        <option value="@article.Id">@article.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-3 d-grid">
                                <button type="button" class="btn btn-outline-primary" @onclick="AddArticle">
                                   Dodaj 
                                </button>
                            </div>
                        </div>

                        <ul class="list-group mb-3">
                            @foreach (var article in order.Articles)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@article.Name </span>
                                    <span>cijena jednog proizvoda: @article.Price € </span>
                                    <span>@article.Quantity x</span>
                                    <button type="button" class="btn btn-sm btn-danger"
                                            @onclick="() => RemoveItem(article)">
                                        x
                                    </button>
                                </li>
                            }
                        </ul>
                            
                        <h5 class="text-primary mb-3">@totalPrice €</h5>
                        
                        <button type="submit" class="btn btn-primary w-100">
                           Spremi 
                        </button>

                    </EditForm>
                    
                     @if (!string.IsNullOrWhiteSpace(message) && message.Length < 150) @*M.G: big messages are from asp.net and are not meant for user *@
                    {
                        <div class="alert alert-info">
                            <span>@message</span>
                        </div>
                    }

                    <div class="mt-4 d-grid gap-2">
                        <a href="/" class="btn btn-outline-primary">Nazad na izbornik</a>
                    </div> 
                    
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private OrderCreationDto order = new();
    private decimal totalPrice = 0;
    private List<ArticleDto> articles = new();
    private Guid selectedArticleId;
    private string message = "";

    protected override async Task OnInitializedAsync()//M.G: loads with page!
    {
        try
        {
            articles = await Http.GetFromJsonAsync<List<ArticleDto>>("http://localhost:5074/api/v1/articles");
        }
        catch (Exception e)
        {
            message ="Error with request: "+ e.Message;
        }
    }
    
    

    private void AddArticle()
    {
        if (selectedArticleId == Guid.Empty)
        {
            return;
        }
        
        var article = articles.FirstOrDefault(a => a.Id == selectedArticleId);
        if (article == null) return;

        if (order.Articles.Contains(article))
        {
            var art=order.Articles.FirstOrDefault(a => a.Equals(article));

            art.Quantity++; //M.G: art is a reference !!!
        }
        else
        {
            order.Articles.Add(article);
        }

        totalPrice += article.Price;
        selectedArticleId = Guid.Empty;
    }

    private void RemoveItem(ArticleDto article)
    {
        var art = order.Articles.FirstOrDefault(article);

        if (art.Quantity == 1)
        {
            order.Articles.Remove(article);
        }
        else
        {
            art.Quantity--; //M.G: refrence!!!
        }
        
        totalPrice -=article.Price;
    }

    private async Task HandleSubmit()
    {

        var newOrderDto = mapper();
        
        try
        {
            var response = await Http.PostAsJsonAsync("http://localhost:5074/api/v1/orders", newOrderDto);
            
            if (response.IsSuccessStatusCode)
            {
                order = new();
                message = "Spremljeno";

                totalPrice = 0;
            }
            else
            {
                message ="Greška: "+ await response.Content.ReadAsStringAsync();
            }
            
        }
        catch 
        {
            message ="Greška: Provajte ponovo.";
        }

     
    }

    public class OrderCreationDto
    {
        public string GuestName { get; set; }
        public int Payment { get; set; }
        public string Address { get; set; }
        public string PhoneNumber { get; set; }
        public string? Notes { get; set; } = "   "; //M.G: quick fix for null bug.
        public List<ArticleDto> Articles{ get; set; } = new();
    }

    public class ArticleDto
    {
        public Guid Id { get; set; }
        public string Name{ get; set; }
        public decimal Price{ get; set; }
        public string Description{ get; set; }
        public int Quantity{ get; set; }
    }

    public OrderFrontendDto mapper()
    {

        return  new OrderFrontendDto(
            null,
            order.GuestName,
            null,
            null,
            (PaymentFrontend)order.Payment,
            order.Address,
            order.PhoneNumber,
            order.Notes,
            0,
            order.Articles.Select(a => new AbySalto.Junior.Application.Dto.ArticleFrontendDto(a.Id,a.Name,a.Price,a.Description,a.Quantity)).ToList()
                
        );
    }

}