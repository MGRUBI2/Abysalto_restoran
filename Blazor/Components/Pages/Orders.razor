@page "/orders"
@inject HttpClient Http
@using System.Net
@using AbySalto.Junior.Application.Dto
@using AbySalto.Junior.Domain.Enums
@using Blazor.Interfaces
@using Blazor.Util.OrderSort
@rendermode InteractiveServer

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            
            
            <div class="row g-2 mb-3">
                <div class="col-md-6">
                    <select class="form-select" @onchange="e => { selectedSortType = e.Value.ToString(); ChangeSortType(); }">
                        
                        <option value="">Sortiraj sadržaj</option>

                        @foreach (var type in sortType)
                        {
                            <option value="@type.Key">@type.Key</option>
                        }
                    </select>
                </div>
            </div>


            <div class="card shadow-sm border-0">

                @foreach (var order in orders)
                {
                    <div class="card-body p-4">

                        <h3 class="text-primary text-center mb-4">Detalji Narudžbe</h3>

                        <div class="mb-3">
                            <strong>Ime kupca:</strong>
                            <div class="text-muted">@order.GuestName</div>
                        </div>

                        <EditForm Model="order" OnValidSubmit="() => UpdateStatus(order.Id)">
                            <strong>Status: </strong>
                            <select class="form-select" @bind="order.Status">
                                @foreach (var status in Enum.GetValues<Status>())
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                            <button type="submit" class="btn btn-primary w-100">
                                Spremi
                            </button>

                        </EditForm>

                        <div class="mb-3">
                            <strong>Način plaćanja:</strong>
                            <div class="text-muted">@order.PaymentFrontend</div>
                        </div>

                        <div class="mb-3">
                            <strong>Adresa:</strong>
                            <div class="text-muted">@order.Address</div>
                        </div>

                        <div class="mb-3">
                            <strong>Datum narudžbe:</strong>
                            <div class="text-muted">@order.OrderDate.DateTime</div>
                        </div>

                        <div class="mb-3">
                            <strong>Broj mobitela:</strong>
                            <div class="text-muted">@order.PhoneNumber</div>
                        </div>

                        <div class="mb-3">
                            <strong>Napomena:</strong>
                            <div class="text-muted">@order.Notes</div>
                        </div>

                        <hr>

                        <h5 class="text-primary mb-3">Naručeni artikli</h5>

                        <ul class="list-group mb-3">
                            @foreach (var article in order.Articles)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    @article.Name
                                    <span> cijena jednog proizvoda: @article.Price €</span>
                                    @article.Quantity x
                                </li>
                            }
                        </ul>

                        <hr>

                        <div class="d-flex justify-content-between fw-bold">
                            <span>Ukupno:</span>
                            <span>@order.TotalAmount €</span>
                        </div>

                        <b><hr></b>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(message) && message.Length < 150) @*M.G: big messages are from asp.net and are not meant for user *@
                    {
                        <div class="alert alert-info">
                            <span>@message</span>
                        </div>
                    }

                }
                <div class="mt-4 d-grid gap-2">
                    <a href="/" class="btn btn-outline-primary">Nazad na izbornik</a>
                </div>

            </div>

        </div>
    </div>
</div>

@code {

    string message = "";
    private ISort<OrderMuttableDto> orderSort ;
    private string selectedSortType="Sortiraj po cijeni silazno";

    private Dictionary<string, ISort<OrderMuttableDto>> sortType = new()
    {
        { "Sortiraj po cijeni uzlazno", new SortByPriceAscending() },
        { "Sortiraj po cijeni silazno", new SortByPriceDescending() }
    };


    private void ChangeSortType()
    {
        if (string.IsNullOrEmpty(selectedSortType)){
            return;
            }
        
        orderSort = sortType[selectedSortType];
        orders=orderSort.Sort(orders).ToList();
    }
    
   public class OrderMuttableDto {
       public Guid Id { get; set; }
       public string GuestName{ get; set; }
       public DateTimeOffset OrderDate{ get; set; }
       public Status Status { get; set; }
       public PaymentFrontend PaymentFrontend{ get; set; }
       public string Address{ get; set; }
       public string PhoneNumber{ get; set; }
       public string Notes{ get; set; }
       public decimal TotalAmount{ get; set; }
       public List<ArticleFrontendDto> Articles { get; set; }
   }
    
    private  List<OrderMuttableDto> orders = new();
    
    

    protected async override Task OnInitializedAsync()
    {
        orders =  await Http.GetFromJsonAsync<List<OrderMuttableDto>>("http://localhost:5074/api/v1/orders");
       // orders= orders.OrderByDescending(o => o.TotalAmount).ToList();//M.G: tmp
       
       // orders=orderSort.Sort(orders).ToList();
    }

    private async Task UpdateStatus(Guid id)
    {
        var order = orders.First(o =>o.Id == id);

        try
        {
            var response = await Http.PutAsJsonAsync($"http://localhost:5074/api/v1/orders/{id}", order);

            if (response.StatusCode == HttpStatusCode.BadRequest)
            {
                message = await response.Content.ReadAsStringAsync();
            }
        }
        catch
        {
            message = "Greška: Provajte ponovo";
        }
    }
}